# Copy this file to .env.local and fill it in. Never commit .env.local.

# Turns on the AI features (Trip Match, nightlife, stays, itinerary, recaps...).
# Get a key at https://platform.claude.com/ (Settings > API keys).
ANTHROPIC_API_KEY=

# Optional: which Claude model to use. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
